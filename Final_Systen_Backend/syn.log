################## Design Compiler Library Files #setup ######################
puts "###########################################"
###########################################
puts "#      #setting Design Libraries           #"
#      #setting Design Libraries           #
puts "###########################################"
###########################################
# ---- adjust these two paths to your virtual machine ----
set PROJECT_DIR   /home/ICer/SYSTEM
/home/ICer/SYSTEM
set STD_CELLS_DIR $PROJECT_DIR/std_cells         ;# folder that contains the .db files
/home/ICer/SYSTEM/std_cells
set RTL_DIR       $PROJECT_DIR                   ;# the RTL block folders are directly inside SYSTEM
/home/ICer/SYSTEM
#Add the path of the libraries to the search_path variable
lappend search_path $STD_CELLS_DIR
. /home/synopsys/syn/O-2018.06-SP1/libraries/syn /home/synopsys/syn/O-2018.06-SP1/minpower/syn /home/synopsys/syn/O-2018.06-SP1/dw/syn_ver /home/synopsys/syn/O-2018.06-SP1/dw/sim_ver /home/ICer/SYSTEM/std_cells
#Add the path of every RTL block folder to the search_path variable
foreach blk {ALU              Async_FIFO              Clock_Divider              Clock_DIV_MUX              Clock_Gating              Data_Sync              Pulse_Gen              Register_File              Reset_Sync              SYS_CTRL              TOP              UART/UART_RX              UART/UART_TOP              UART/UART_TX} {
    lappend search_path $RTL_DIR/$blk
}
